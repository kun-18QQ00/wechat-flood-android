# message.kv v9.1 - 美化版

<Card@BoxLayout>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(10)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<RootWidget>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0.94, 0.95, 0.97, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # 顶部标题栏
    BoxLayout:
        size_hint_y: None
        height: dp(60)
        padding: dp(16), 0
        canvas.before:
            Color:
                rgba: 0.2, 0.45, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: '消息助手'
            font_size: sp(24)
            font_name: app.font_name
            bold: True
            color: 1, 1, 1, 1
            halign: 'center'
            text_size: self.size

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: 'vertical'
            padding: dp(14), dp(14)
            spacing: dp(14)
            size_hint_y: None
            height: self.minimum_height

            # 无障碍服务
            Card:
                Label:
                    text: '无障碍服务'
                    font_size: sp(17)
                    font_name: app.font_name
                    bold: True
                    color: 0.1, 0.1, 0.15, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(30)
                    Label:
                        text: '已连接' if app.service_ok else '未开启'
                        font_size: sp(15)
                        font_name: app.font_name
                        color: (0, 0.65, 0.2, 1) if app.service_ok else (0.85, 0.2, 0.1, 1)
                        halign: 'left'
                        text_size: self.size

                Button:
                    text: '打开无障碍设置'
                    font_size: sp(16)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(48)
                    background_color: 0.2, 0.45, 1, 1
                    color: 1, 1, 1, 1
                    on_press: app.open_settings()

                Label:
                    text: '开启后自动识别任意聊天框发送消息'
                    font_size: sp(13)
                    font_name: app.font_name
                    color: 0.45, 0.45, 0.5, 1
                    size_hint_y: None
                    height: dp(22)
                    halign: 'left'
                    text_size: self.size

            # 消息输入
            Card:
                Label:
                    text: '消息内容'
                    font_size: sp(17)
                    font_name: app.font_name
                    bold: True
                    color: 0.1, 0.1, 0.15, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'left'
                    text_size: self.size

                TextInput:
                    id: msg_input
                    hint_text: '输入要发送的消息，每行一条'
                    multiline: True
                    font_size: sp(18)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(130)
                    padding: dp(14)
                    background_color: 0.95, 0.95, 0.97, 1
                    foreground_color: 0.1, 0.1, 0.15, 1
                    cursor_color: 0.2, 0.45, 1, 1

            # 发送设置
            Card:
                Label:
                    text: '发送设置'
                    font_size: sp(17)
                    font_name: app.font_name
                    bold: True
                    color: 0.1, 0.1, 0.15, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(10)

                    Label:
                        text: '间隔(秒)'
                        font_size: sp(16)
                        font_name: app.font_name
                        color: 0.25, 0.25, 0.3, 1
                        size_hint_x: 0.28
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: speed_input
                        text: '1.0'
                        font_size: sp(18)
                        font_name: app.font_name
                        size_hint_x: 0.22
                        size_hint_y: None
                        height: dp(44)
                        padding: dp(10)
                        background_color: 0.95, 0.95, 0.97, 1
                        foreground_color: 0.1, 0.1, 0.15, 1
                        input_filter: 'float'
                        multiline: False

                    Label:
                        text: '批量'
                        font_size: sp(16)
                        font_name: app.font_name
                        color: 0.25, 0.25, 0.3, 1
                        size_hint_x: 0.15
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: batch_input
                        text: '0'
                        font_size: sp(18)
                        font_name: app.font_name
                        size_hint_x: 0.15
                        size_hint_y: None
                        height: dp(44)
                        padding: dp(10)
                        background_color: 0.95, 0.95, 0.97, 1
                        foreground_color: 0.1, 0.1, 0.15, 1
                        input_filter: 'int'
                        multiline: False

                    Label:
                        text: '0=无限'
                        font_size: sp(13)
                        font_name: app.font_name
                        color: 0.5, 0.5, 0.55, 1
                        size_hint_x: 0.2

            # 控制按钮
            Card:
                Label:
                    text: '控制'
                    font_size: sp(17)
                    font_name: app.font_name
                    bold: True
                    color: 0.1, 0.1, 0.15, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(54)
                    spacing: dp(12)

                    Button:
                        text: '开始发送'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 0, 0.72, 0.3, 1
                        color: 1, 1, 1, 1
                        disabled: app.is_running
                        on_press: app.start()

                    Button:
                        text: '暂停' if not app.is_paused else '继续'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 1, 0.58, 0, 1
                        color: 1, 1, 1, 1
                        disabled: not app.is_running
                        on_press: app.pause()

                    Button:
                        text: '停止'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 0.9, 0.18, 0.15, 1
                        color: 1, 1, 1, 1
                        disabled: not app.is_running
                        on_press: app.stop()

            # 状态
            Card:
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)

                    Label:
                        text: app.status_text
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        color: 0.1, 0.1, 0.15, 1
                        halign: 'left'
                        text_size: self.size

                    Label:
                        text: app.count_text
                        font_size: sp(30)
                        font_name: app.font_name
                        bold: True
                        color: 0.2, 0.45, 1, 1
                        halign: 'right'
                        text_size: self.size

                Label:
                    text: app.speed_text
                    font_size: sp(14)
                    font_name: app.font_name
                    color: 0.45, 0.45, 0.5, 1
                    size_hint_y: None
                    height: dp(22)
                    halign: 'left'
                    text_size: self.size

            # 日志
            Card:
                Label:
                    text: '日志'
                    font_size: sp(17)
                    font_name: app.font_name
                    bold: True
                    color: 0.1, 0.1, 0.15, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'left'
                    text_size: self.size

                TextInput:
                    id: log_area
                    readonly: True
                    font_size: sp(14)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(180)
                    padding: dp(12)
                    background_color: 0.12, 0.13, 0.18, 1
                    foreground_color: 0.3, 1, 0.5, 1
                    cursor_color: 0, 0, 0, 0
