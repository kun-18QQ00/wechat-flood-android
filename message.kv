# message.kv v9.3 - 柔光玻璃风格

<GlassCard@BoxLayout>:
    orientation: 'vertical'
    padding: dp(18)
    spacing: dp(10)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.65
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]

<RootWidget>:
    orientation: 'vertical'
    canvas.before:
        # 渐变背景
        Color:
            rgba: 0.42, 0.62, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size
        # 光晕效果
        Color:
            rgba: 0.6, 0.8, 1, 0.3
        Ellipse:
            pos: self.width * 0.3, self.height * 0.5
            size: self.width * 0.8, self.width * 0.8

    # 顶部栏
    BoxLayout:
        size_hint_y: None
        height: dp(60)
        padding: dp(16), 0
        canvas.before:
            Color:
                rgba: 1, 1, 1, 0.2
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: '消息助手'
            font_size: sp(22)
            font_name: app.font_name
            bold: True
            color: 1, 1, 1, 1
            halign: 'center'
            text_size: self.size

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: 'vertical'
            padding: dp(16), dp(12)
            spacing: dp(12)
            size_hint_y: None
            height: self.minimum_height

            # 无障碍服务
            GlassCard:
                Label:
                    text: '无障碍服务'
                    font_size: sp(15)
                    font_name: app.font_name
                    bold: True
                    color: 0.15, 0.15, 0.25, 1
                    size_hint_y: None
                    height: dp(26)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(24)
                    Label:
                        text: '已连接' if app.service_ok else '未开启'
                        font_size: sp(14)
                        font_name: app.font_name
                        color: (0.1, 0.75, 0.35, 1) if app.service_ok else (0.85, 0.3, 0.25, 1)
                        halign: 'left'
                        text_size: self.size

                Button:
                    text: '打开无障碍设置'
                    font_size: sp(15)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(46)
                    background_color: 0, 0, 0, 0
                    color: 1, 1, 1, 1
                    canvas.before:
                        Color:
                            rgba: 0.3, 0.55, 0.95, 0.9
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]
                    on_press: app.open_settings()

                Label:
                    text: '找不到？重启APP后再试'
                    font_size: sp(12)
                    font_name: app.font_name
                    color: 0.4, 0.4, 0.55, 1
                    size_hint_y: None
                    height: dp(18)
                    halign: 'left'
                    text_size: self.size

            # 消息输入
            GlassCard:
                Label:
                    text: '消息内容'
                    font_size: sp(15)
                    font_name: app.font_name
                    bold: True
                    color: 0.15, 0.15, 0.25, 1
                    size_hint_y: None
                    height: dp(26)
                    halign: 'left'
                    text_size: self.size

                TextInput:
                    id: msg_input
                    hint_text: '输入消息，每行一条'
                    multiline: True
                    font_size: sp(17)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(110)
                    padding: dp(12)
                    background_color: 1, 1, 1, 0.5
                    foreground_color: 0.1, 0.1, 0.2, 1
                    cursor_color: 0.3, 0.55, 0.95, 1

            # 发送设置
            GlassCard:
                Label:
                    text: '发送设置'
                    font_size: sp(15)
                    font_name: app.font_name
                    bold: True
                    color: 0.15, 0.15, 0.25, 1
                    size_hint_y: None
                    height: dp(26)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(42)
                    spacing: dp(8)

                    Label:
                        text: '间隔秒'
                        font_size: sp(14)
                        font_name: app.font_name
                        color: 0.25, 0.25, 0.35, 1
                        size_hint_x: 0.22
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: speed_input
                        text: '1.0'
                        font_size: sp(16)
                        font_name: app.font_name
                        size_hint_x: 0.25
                        size_hint_y: None
                        height: dp(38)
                        padding: dp(8)
                        background_color: 1, 1, 1, 0.5
                        foreground_color: 0.1, 0.1, 0.2, 1
                        input_filter: 'float'
                        multiline: False

                    Label:
                        text: '批量'
                        font_size: sp(14)
                        font_name: app.font_name
                        color: 0.25, 0.25, 0.35, 1
                        size_hint_x: 0.15
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: batch_input
                        text: '0'
                        font_size: sp(16)
                        font_name: app.font_name
                        size_hint_x: 0.18
                        size_hint_y: None
                        height: dp(38)
                        padding: dp(8)
                        background_color: 1, 1, 1, 0.5
                        foreground_color: 0.1, 0.1, 0.2, 1
                        input_filter: 'int'
                        multiline: False

                    Label:
                        text: '0=无限'
                        font_size: sp(11)
                        font_name: app.font_name
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_x: 0.2

            # 控制
            GlassCard:
                Label:
                    text: '控制'
                    font_size: sp(15)
                    font_name: app.font_name
                    bold: True
                    color: 0.15, 0.15, 0.25, 1
                    size_hint_y: None
                    height: dp(26)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    Button:
                        text: '开始'
                        font_size: sp(16)
                        font_name: app.font_name
                        bold: True
                        background_color: 0, 0, 0, 0
                        color: 1, 1, 1, 1
                        disabled: app.is_running
                        canvas.before:
                            Color:
                                rgba: (0.15, 0.72, 0.35, 0.9) if not self.disabled else (0.6, 0.6, 0.6, 0.5)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                        on_press: app.start()

                    Button:
                        text: '暂停' if not app.is_paused else '继续'
                        font_size: sp(16)
                        font_name: app.font_name
                        bold: True
                        background_color: 0, 0, 0, 0
                        color: 1, 1, 1, 1
                        disabled: not app.is_running
                        canvas.before:
                            Color:
                                rgba: (1, 0.55, 0.1, 0.9) if not self.disabled else (0.6, 0.6, 0.6, 0.5)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                        on_press: app.pause()

                    Button:
                        text: '停止'
                        font_size: sp(16)
                        font_name: app.font_name
                        bold: True
                        background_color: 0, 0, 0, 0
                        color: 1, 1, 1, 1
                        disabled: not app.is_running
                        canvas.before:
                            Color:
                                rgba: (0.9, 0.2, 0.2, 0.9) if not self.disabled else (0.6, 0.6, 0.6, 0.5)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                        on_press: app.stop()

            # 状态
            GlassCard:
                BoxLayout:
                    size_hint_y: None
                    height: dp(36)
                    Label:
                        text: app.status_text
                        font_size: sp(16)
                        font_name: app.font_name
                        bold: True
                        color: 0.15, 0.15, 0.25, 1
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: app.count_text
                        font_size: sp(26)
                        font_name: app.font_name
                        bold: True
                        color: 0.3, 0.55, 0.95, 1
                        halign: 'right'
                        text_size: self.size

                Label:
                    text: app.speed_text
                    font_size: sp(13)
                    font_name: app.font_name
                    color: 0.45, 0.45, 0.55, 1
                    size_hint_y: None
                    height: dp(18)
                    halign: 'left'
                    text_size: self.size

            # 日志
            GlassCard:
                Label:
                    text: '日志'
                    font_size: sp(15)
                    font_name: app.font_name
                    bold: True
                    color: 0.15, 0.15, 0.25, 1
                    size_hint_y: None
                    height: dp(26)
                    halign: 'left'
                    text_size: self.size

                TextInput:
                    id: log_area
                    readonly: True
                    font_size: sp(12)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(140)
                    padding: dp(10)
                    background_color: 0.1, 0.12, 0.2, 0.8
                    foreground_color: 0.45, 0.95, 0.65, 1
                    cursor_color: 0, 0, 0, 0
