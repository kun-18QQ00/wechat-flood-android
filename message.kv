# message.kv - 消息助手 v8.1

<AnimatedCard@BoxLayout>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(10)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<IOSSectionTitle@Label>:
    font_size: sp(13)
    font_name: app.font_name
    color: 0.427, 0.427, 0.447, 1
    size_hint_y: None
    height: dp(20)
    halign: 'left'
    valign: 'middle'
    text_size: self.size

<RootWidget>:
    canvas.before:
        Color:
            rgba: 0.949, 0.949, 0.969, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: 'vertical'
            padding: dp(16), dp(20), dp(16), dp(20)
            spacing: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ── 标题 ──
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(60)
                spacing: dp(4)

                Label:
                    text: '消息助手 v8.1'
                    font_size: sp(34)
                    font_name: app.font_name
                    bold: True
                    color: 0.11, 0.11, 0.118, 1
                    size_hint_y: None
                    height: dp(40)
                    halign: 'left'
                    text_size: self.size

                Label:
                    text: '自动识别聊天框 · 完全自动发送'
                    font_size: sp(15)
                    font_name: app.font_name
                    color: 0.427, 0.427, 0.447, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: 'left'
                    text_size: self.size

            # ── 无障碍服务状态 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '无障碍服务'

                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(12)

                    Label:
                        text: '状态: ' + app.service_status
                        font_size: sp(17)
                        font_name: app.font_name
                        color: (0.204, 0.788, 0.349, 1) if '已连接' in app.service_status else (1, 0.231, 0.188, 1)
                        halign: 'left'
                        text_size: self.size

                    Button:
                        text: '开启无障碍'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: 0, 0.478, 1, 1
                        color: 1, 1, 1, 1
                        size_hint_x: 0.4
                        size_hint_y: None
                        height: dp(44)
                        on_press: app.open_accessibility_settings()

            # ── 目标应用 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '目标应用'

                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: dp(100)
                    spacing: dp(10)

                    Button:
                        text: '微信'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0.204, 0.788, 0.349, 1) if app.selected_app == '微信' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_app == '微信' else 0.11
                        on_press: app.select_app('微信')

                    Button:
                        text: 'QQ'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0, 0.478, 1, 1) if app.selected_app == 'QQ' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_app == 'QQ' else 0.11
                        on_press: app.select_app('QQ')

                    Button:
                        text: '钉钉'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0.204, 0.627, 0.949, 1) if app.selected_app == '钉钉' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_app == '钉钉' else 0.11
                        on_press: app.select_app('钉钉')

                    Button:
                        text: '飞书'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0.204, 0.627, 0.949, 1) if app.selected_app == '飞书' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_app == '飞书' else 0.11
                        on_press: app.select_app('飞书')

                    Button:
                        text: 'Telegram'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0.114, 0.643, 0.949, 1) if app.selected_app == 'Telegram' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_app == 'Telegram' else 0.11
                        on_press: app.select_app('Telegram')

                    Button:
                        text: 'WhatsApp'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0.18, 0.722, 0.451, 1) if app.selected_app == 'WhatsApp' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_app == 'WhatsApp' else 0.11
                        on_press: app.select_app('WhatsApp')

            # ── 消息输入 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '消息内容'

                TextInput:
                    id: msg_input
                    hint_text: '输入消息，每行一条'
                    multiline: True
                    font_size: sp(17)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(150)
                    padding: dp(12), dp(10)
                    background_color: 0.95, 0.95, 0.97, 1
                    foreground_color: 0.11, 0.11, 0.118, 1
                    cursor_color: 0, 0.478, 1, 1
                    on_text: app._update_char_count()

                Label:
                    id: char_count
                    text: '0 字符'
                    font_size: sp(13)
                    font_name: app.font_name
                    color: 0.627, 0.627, 0.647, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: 'right'
                    text_size: self.size

                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(10)

                    Button:
                        text: '表情'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: 0.204, 0.788, 0.349, 1
                        color: 1, 1, 1, 1
                        on_press: app.load_preset('emoji')

                    Button:
                        text: '问候'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: 1, 0.584, 0, 1
                        color: 1, 1, 1, 1
                        on_press: app.load_preset('greeting')

                    Button:
                        text: '数字'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: 0, 0.478, 1, 1
                        color: 1, 1, 1, 1
                        on_press: app.load_preset('numbers')

            # ── 发送模式 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '发送模式'

                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: dp(44)
                    spacing: dp(10)

                    Button:
                        text: '顺序'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0, 0.478, 1, 1) if app.selected_mode == '顺序' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_mode == '顺序' else 0.11
                        on_press: app.select_mode('顺序')

                    Button:
                        text: '随机'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (0.204, 0.788, 0.349, 1) if app.selected_mode == '随机' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_mode == '随机' else 0.11
                        on_press: app.select_mode('随机')

                    Button:
                        text: '单条'
                        font_size: sp(15)
                        font_name: app.font_name
                        background_color: (1, 0.584, 0, 1) if app.selected_mode == '单条' else (0.9, 0.9, 0.9, 1)
                        color: 1, 1, 1, 1 if app.selected_mode == '单条' else 0.11
                        on_press: app.select_mode('单条')

            # ── 速度设置 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '发送设置'

                BoxLayout:
                    size_hint_y: None
                    height: dp(44)
                    spacing: dp(12)

                    Label:
                        text: '间隔(秒)'
                        font_size: sp(17)
                        font_name: app.font_name
                        color: 0.11, 0.11, 0.118, 1
                        size_hint_x: 0.3
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: speed_input
                        text: '1.0'
                        font_size: sp(17)
                        font_name: app.font_name
                        size_hint_x: 0.35
                        size_hint_y: None
                        height: dp(40)
                        padding: dp(10), dp(8)
                        background_color: 0.95, 0.95, 0.97, 1
                        foreground_color: 0.11, 0.11, 0.118, 1
                        input_filter: 'float'
                        multiline: False

                    Label:
                        text: '批量'
                        font_size: sp(17)
                        font_name: app.font_name
                        color: 0.11, 0.11, 0.118, 1
                        size_hint_x: 0.15
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: batch_input
                        text: '0'
                        font_size: sp(17)
                        font_name: app.font_name
                        size_hint_x: 0.2
                        size_hint_y: None
                        height: dp(40)
                        padding: dp(10), dp(8)
                        background_color: 0.95, 0.95, 0.97, 1
                        foreground_color: 0.11, 0.11, 0.118, 1
                        input_filter: 'int'
                        multiline: False

            # ── 控制 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '控制'

                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: dp(55)
                    spacing: dp(12)

                    Button:
                        id: btn_start
                        text: '开始'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 0.204, 0.788, 0.349, 1
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: dp(55)
                        disabled: app.is_running
                        on_press: app.start_sending()

                    Button:
                        id: btn_pause
                        text: '暂停' if not app.is_paused else '继续'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 1, 0.584, 0, 1
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: dp(55)
                        disabled: not app.is_running
                        on_press: app.pause_sending()

                    Button:
                        id: btn_stop
                        text: '停止'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 1, 0.231, 0.188, 1
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: dp(55)
                        disabled: not app.is_running
                        on_press: app.stop_sending()

            # ── 状态 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '状态'

                BoxLayout:
                    size_hint_y: None
                    height: dp(50)

                    Label:
                        text: app.status_text
                        font_size: sp(17)
                        font_name: app.font_name
                        color: (0.204, 0.788, 0.349, 1) if app.status_text == '运行中...' else (0.11, 0.11, 0.118, 1)
                        halign: 'left'
                        text_size: self.size

                    Label:
                        text: app.count_text
                        font_size: sp(32)
                        font_name: app.font_name
                        bold: True
                        color: 0, 0.478, 1, 1
                        halign: 'right'
                        text_size: self.size

                Label:
                    text: app.stats_text
                    font_size: sp(13)
                    font_name: app.font_name
                    color: 0.627, 0.627, 0.647, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: 'left'
                    text_size: self.size

            # ── 日志 ──
            AnimatedCard:
                IOSSectionTitle:
                    text: '日志'

                TextInput:
                    id: log_area
                    readonly: True
                    font_size: sp(14)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(200)
                    padding: dp(10), dp(8)
                    background_color: 0.11, 0.11, 0.118, 1
                    foreground_color: 0.204, 0.788, 0.349, 1
                    cursor_color: 0, 0, 0, 0
