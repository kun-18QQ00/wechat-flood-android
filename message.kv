# message.kv v9.0

<Card@BoxLayout>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(8)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

<RootWidget>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0.96, 0.96, 0.96, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # 顶部标题栏
    BoxLayout:
        size_hint_y: None
        height: dp(56)
        padding: dp(16), 0
        canvas.before:
            Color:
                rgba: 0.2, 0.2, 0.2, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: '[b]消息助手[/b]'
            markup: True
            font_size: sp(22)
            font_name: app.font_name
            color: 1, 1, 1, 1
            halign: 'center'
            text_size: self.size

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: 'vertical'
            padding: dp(12), dp(12)
            spacing: dp(12)
            size_hint_y: None
            height: self.minimum_height

            # 无障碍服务
            Card:
                Label:
                    text: '[b]无障碍服务[/b]'
                    markup: True
                    font_size: sp(16)
                    font_name: app.font_name
                    color: 0.1, 0.1, 0.1, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: 'left'
                    text_size: self.size

                Label:
                    text: '已连接' if app.service_ok else '未开启 - 请点击下方按钮'
                    font_size: sp(15)
                    font_name: app.font_name
                    color: (0, 0.6, 0, 1) if app.service_ok else (0.9, 0.1, 0.1, 1)
                    size_hint_y: None
                    height: dp(24)
                    halign: 'left'
                    text_size: self.size

                Button:
                    text: '打开无障碍设置'
                    font_size: sp(16)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(44)
                    background_color: 0.15, 0.5, 0.9, 1
                    color: 1, 1, 1, 1
                    on_press: app.open_settings()

                Label:
                    text: '开启后会自动识别任意聊天框并发送'
                    font_size: sp(13)
                    font_name: app.font_name
                    color: 0.4, 0.4, 0.4, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: 'left'
                    text_size: self.size

            # 消息输入
            Card:
                Label:
                    text: '[b]消息内容[/b]  每行一条'
                    markup: True
                    font_size: sp(16)
                    font_name: app.font_name
                    color: 0.1, 0.1, 0.1, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: 'left'
                    text_size: self.size

                TextInput:
                    id: msg_input
                    hint_text: '在这里输入消息'
                    multiline: True
                    font_size: sp(18)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(120)
                    padding: dp(12)
                    background_color: 0.94, 0.94, 0.94, 1
                    foreground_color: 0, 0, 0, 1
                    cursor_color: 0, 0, 0, 1

            # 发送设置
            Card:
                Label:
                    text: '[b]发送设置[/b]'
                    markup: True
                    font_size: sp(16)
                    font_name: app.font_name
                    color: 0.1, 0.1, 0.1, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(44)
                    spacing: dp(8)

                    Label:
                        text: '间隔(秒)'
                        font_size: sp(16)
                        font_name: app.font_name
                        color: 0.2, 0.2, 0.2, 1
                        size_hint_x: 0.3
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: speed_input
                        text: '1.0'
                        font_size: sp(18)
                        font_name: app.font_name
                        size_hint_x: 0.3
                        size_hint_y: None
                        height: dp(40)
                        padding: dp(8)
                        background_color: 0.94, 0.94, 0.94, 1
                        foreground_color: 0, 0, 0, 1
                        input_filter: 'float'
                        multiline: False

                    Label:
                        text: '批量(0=无限)'
                        font_size: sp(16)
                        font_name: app.font_name
                        color: 0.2, 0.2, 0.2, 1
                        size_hint_x: 0.25
                        halign: 'left'
                        text_size: self.size

                    TextInput:
                        id: batch_input
                        text: '0'
                        font_size: sp(18)
                        font_name: app.font_name
                        size_hint_x: 0.15
                        size_hint_y: None
                        height: dp(40)
                        padding: dp(8)
                        background_color: 0.94, 0.94, 0.94, 1
                        foreground_color: 0, 0, 0, 1
                        input_filter: 'int'
                        multiline: False

            # 控制按钮
            Card:
                Label:
                    text: '[b]控制[/b]'
                    markup: True
                    font_size: sp(16)
                    font_name: app.font_name
                    color: 0.1, 0.1, 0.1, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    Button:
                        text: '开始发送'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 0, 0.7, 0.3, 1
                        color: 1, 1, 1, 1
                        disabled: app.is_running
                        on_press: app.start()

                    Button:
                        text: '暂停' if not app.is_paused else '继续'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 1, 0.6, 0, 1
                        color: 1, 1, 1, 1
                        disabled: not app.is_running
                        on_press: app.pause()

                    Button:
                        text: '停止'
                        font_size: sp(18)
                        font_name: app.font_name
                        bold: True
                        background_color: 0.9, 0.15, 0.15, 1
                        color: 1, 1, 1, 1
                        disabled: not app.is_running
                        on_press: app.stop()

            # 状态
            Card:
                BoxLayout:
                    size_hint_y: None
                    height: dp(36)

                    Label:
                        text: app.status_text
                        font_size: sp(17)
                        font_name: app.font_name
                        color: 0.1, 0.1, 0.1, 1
                        halign: 'left'
                        text_size: self.size

                    Label:
                        text: app.count_text
                        font_size: sp(28)
                        font_name: app.font_name
                        bold: True
                        color: 0.15, 0.5, 0.9, 1
                        halign: 'right'
                        text_size: self.size

                Label:
                    text: app.speed_text
                    font_size: sp(14)
                    font_name: app.font_name
                    color: 0.4, 0.4, 0.4, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: 'left'
                    text_size: self.size

            # 日志
            Card:
                Label:
                    text: '[b]日志[/b]'
                    markup: True
                    font_size: sp(16)
                    font_name: app.font_name
                    color: 0.1, 0.1, 0.1, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: 'left'
                    text_size: self.size

                TextInput:
                    id: log_area
                    readonly: True
                    font_size: sp(14)
                    font_name: app.font_name
                    size_hint_y: None
                    height: dp(160)
                    padding: dp(10)
                    background_color: 0.15, 0.15, 0.15, 1
                    foreground_color: 0, 1, 0.4, 1
                    cursor_color: 0, 0, 0, 0
